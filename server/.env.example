# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string. In production this points at the shared
# Postgres host (see README "Data tier" section) — same value on web-01
# and web-02.
DATABASE_URL=postgres://sokoledger:sokoledger@localhost:5432/sokoledger

# RapidAPI key for the parsing endpoint below.
# Server-side only — never sent to or read by any frontend code.
RAPIDAPI_KEY=your-rapidapi-key-here

# Full URL of the RapidAPI endpoint that turns sale text into JSON.
# Defaults to open-ai21's conversationllama endpoint if unset.
RAPIDAPI_URL=https://open-ai21.p.rapidapi.com/conversationllama

# Signs JWTs. Must be identical on web-01 and web-02 so either server can
# verify a token issued by the other.
SESSION_SECRET=change-this-to-a-long-random-string

PORT=3000
