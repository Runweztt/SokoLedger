# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string. In production this points at Supabase (see
# README "Data tier" section), same value on web-01 and web-02.
DATABASE_URL=postgres://sokoledger:sokoledger@localhost:5432/sokoledger

# RapidAPI key for the parsing endpoint below.
# Server-side only, never sent to or read by any frontend code.
RAPIDAPI_KEY=your-rapidapi-key-here

# Full URL of the RapidAPI conversational endpoint that turns sale text
# into JSON. Optional, defaults to the value below if unset.
RAPIDAPI_URL=https://chatgpt-42.p.rapidapi.com/conversationgpt4-2

# Signs JWTs. Must be identical on web-01 and web-02 so either server can
# verify a token issued by the other.
SESSION_SECRET=change-this-to-a-long-random-string

PORT=3000
